# Copie para .env.local e preencha com os dados do SEU projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave secreta (service_role). Só no servidor: nunca coloque NEXT_PUBLIC_ nela.
# Usada pela central pública (QR Code) e pelo job que gera as tarefas recorrentes.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Endereço do app (vai nos QR Codes e nos links do WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Qualquer texto longo e aleatório. A Vercel usa para autorizar o cron.
CRON_SECRET=troque-por-um-texto-aleatorio

# WhatsApp pela Evolution API (servidor próprio; veja docs/whatsapp.md).
# Sem estas três, a conexão aparece como "Configuração pendente" e nada é enviado.
# Endereço https da sua Evolution, ex.: https://evolution.seudominio.com.br
EVOLUTION_API_URL=
# A mesma AUTHENTICATION_API_KEY do servidor da Evolution
EVOLUTION_API_KEY=
# Texto aleatório com 32+ caracteres. A Evolution assina o webhook com ele (JWT).
WHATSAPP_WEBHOOK_SECRET=
