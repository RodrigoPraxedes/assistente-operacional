# Variáveis do SERVIDOR da Evolution (não da Vercel). Nunca coloque valores reais no Git.
# Nomes conferidos no .env.example oficial da Evolution v2.3.7.

# Endereço público (com HTTPS) onde a Evolution vai responder, ex.: evolution.seudominio.com.br
EVOLUTION_DOMINIO=
SERVER_URL=

# Chave global: texto longo e aleatório. A MESMA vai na Vercel como EVOLUTION_API_KEY.
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# Banco da própria Evolution (sessões do WhatsApp). Senha longa e aleatória.
POSTGRES_PASSWORD=
DATABASE_PROVIDER=postgresql
# troque SENHA pela mesma POSTGRES_PASSWORD
DATABASE_CONNECTION_URI=postgresql://evolution:SENHA@postgres:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=assistente_operacional

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# Não apagar instância desconectada (reconectar não perde nada)
DEL_INSTANCE=false
# Webhook só por instância (o app configura sozinho); nada global
WEBHOOK_GLOBAL_ENABLED=false
# Logs sem WEBHOOKS: esse nível grava o conteúdo das mensagens e a apikey
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
TELEMETRY_ENABLED=false
LANGUAGE=pt-BR
QRCODE_LIMIT=30
QRCODE_COLOR=#000000
CONFIG_SESSION_PHONE_CLIENT=Assistente Operacional
CONFIG_SESSION_PHONE_NAME=Chrome
